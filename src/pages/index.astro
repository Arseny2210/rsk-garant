---
import BaseLayout from '../layouts/BaseLayout.astro';
import Process from '../components/Process.astro';
import WhyUs from '../components/WhyUs.astro';
import Reviews from '../components/Reviews.astro';
import CostCalculator from '../components/CostCalculator.astro';
import AdditionalServices from '../components/AdditionalServices.astro';
import FormSection from '../components/FormSection.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Contacts from '../components/Contacts.astro';
import Promotions from '../components/Promotions.astro';
import Advantages from '../components/Advantages.astro';
import { company, SITE_URL } from '../data/company';
import { mainServices } from '../data/services';
import { projects, projectImages } from '../data/projects';
import { homeFaq } from '../data/faq';

const title = 'Ремонт квартир в Москве и Московской области — РСК Гарант';
const description =
  'РСК Гарант — ремонт квартир под ключ и отдельные работы в Москве и Московской области. Бесплатная оценка, смета, работа по договору. Оставьте заявку.';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const servicesSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: mainServices.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: s.title,
      url: SITE_URL + s.slug,
      serviceType: s.title,
      areaServed: [company.cityNominative, company.region],
      provider: { '@id': SITE_URL + '/#organization' },
    },
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={[servicesSchema, faqSchema]}
>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__grid">
      <div>
        <div class="hero__badge">{company.name} - ремонтно-строительная компания</div>
        <h1>Ремонт квартир и отдельные строительные работы в {company.city}</h1>
        <p>
          Выполняем ремонт под ключ, отделочные и строительные работы.
          Поможем оценить объем работ и подготовить предварительный расчет.
        </p>
        <div class="hero__cta">
          <button class="btn btn--primary" type="button" data-open-form>
            Рассчитать стоимость
            <span class="btn__arrow" aria-hidden="true">→</span>
          </button>
          <a class="btn btn--ghost" href="#projects">Посмотреть работы</a>
        </div>

        <div class="hero__facts" aria-label="Ключевые факты">
          <div class="hero__fact">
            <b>{company.cityNominative}</b>
            <span>и {company.region}</span>
          </div>
          <div class="hero__fact">
            <b>Бесплатно</b>
            <span>выезд замерщика и оценка работ</span>
          </div>
          <div class="hero__fact">
            <b>Договор</b>
            <span>фиксируем стоимость до начала работ</span>
          </div>
        </div>
      </div>

      <div class="hero__media">
        <img
          src="/images/hero/hero-interior.webp"
          alt="Гостиная после ремонта — светлый интерьер с большими окнами"
          width="1600"
          height="1067"
          fetchpriority="high"
          data-lightbox
          data-caption="Пример готового интерьера после ремонта"
        />
      </div>
    </div>
  </section>

  <!-- Quick facts -->
  <section class="quickfacts" aria-label="Преимущества">
    <div class="container">
      <h2 class="sr-only">Преимущества</h2>
      <div class="quickfacts__grid reveal-stagger">
        <div class="quickfacts__item">
          <div class="quickfacts__num">01</div>
          <h3>Оценка работ</h3>
          <p>Выезд на объект, замеры и консультация специалиста.</p>
        </div>
        <div class="quickfacts__item">
          <div class="quickfacts__num">02</div>
          <h3>Составление сметы</h3>
          <p>Предварительный расчет по работам и материалам.</p>
        </div>
        <div class="quickfacts__item">
          <div class="quickfacts__num">03</div>
          <h3>Работа по договору</h3>
          <p>Стоимость фиксируется в договоре до начала работ.</p>
        </div>
        <div class="quickfacts__item">
          <div class="quickfacts__num">04</div>
          <h3>Связь с менеджером</h3>
          <p>Отвечаем на вопросы и сопровождаем на всех этапах.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Основные услуги -->
  <section class="section" id="services" aria-labelledby="services-title">
    <div class="container">
      <div class="sec-head sec-head--row">
        <div>
          <div class="sec-head__label">Услуги</div>
          <h2 id="services-title">Основные направления ремонта</h2>
          <p>Работы, которые выполняем чаще всего — подробнее о каждой на отдельной странице.</p>
        </div>
      </div>

      <div class="services-grid reveal-stagger">
        {
          mainServices.map((s, i) => (
            <a
              class="service-card"
              href={s.slug}
              data-service-card={s.title}
              aria-label={`${s.title} — подробнее`}
            >
              <div class="service-card__media">
                <span class="service-card__num">{String(i + 1).padStart(2, '0')}</span>
                <img src={s.image} alt={s.imageAlt} loading="lazy" width="640" height="400" />
              </div>
              <div class="service-card__body">
                <h3>{s.title}</h3>
                {s.priceFrom && <span class="price-tag">{s.priceFrom}</span>}
                <p>{s.subtitle}</p>
                <span class="service-card__link">
                  Подробнее
                  <span aria-hidden="true">→</span>
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Акции -->
  <Promotions />

  <!-- Портфолио -->
  <section class="section section--soft" id="projects" aria-labelledby="projects-title">
    <div class="container">
      <div class="sec-head sec-head--row">
        <div>
          <div class="sec-head__label">Работы</div>
          <h2 id="projects-title">Наши работы</h2>
          <p>Нажмите на фото — откроется галерея с примерами работ.</p>
        </div>
      </div>

      <div class="portfolio-grid reveal-stagger">
        {
          projects.slice(0, 12).map((p, i) => {
            const images = projectImages(p);
            return (
              <article
                class={'project-card' + (i === 0 ? ' project-card--lg' : i === 1 ? ' project-card--sm' : '')}
                data-portfolio
                data-lightbox
                data-gallery={p.id}
                data-gallery-images={JSON.stringify(images)}
                data-caption={p.title}
                tabindex="0"
                role="button"
                aria-label={`${p.title} — открыть галерею из ${images.length} фото`}
              >
                <div class="project-card__media">
                  <img src={p.image} alt={p.alt} loading="lazy" width="1200" height="1600" />
                  <span class="project-card__hint" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                      <path
                        d="M9 4H4v5M15 4h5v5M9 20H4v-5M15 20h5v-5"
                        stroke="currentColor"
                        stroke-width="1.9"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                    </svg>
                    <span>Открыть галерею</span>
                  </span>
                  {images.length > 1 && (
                    <span class="project-card__gallery">
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <rect x="3" y="4" width="13" height="13" rx="2.5" stroke="currentColor" stroke-width="1.7" />
                        <path d="M8 20h10a3 3 0 0 0 3-3V8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                        <circle cx="8.3" cy="9.3" r="1.5" fill="currentColor" />
                        <path d="m3 13 3.1-3.1a1.6 1.6 0 0 1 2.3 0L15 16.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                      <span>{images.length} фото</span>
                    </span>
                  )}
                </div>
                <div class="project-card__info">
                  <div class="work-type">{p.workType}</div>
                  <h3>{p.title}</h3>
                  {
                    (p.area || p.city || p.duration) && (
                      <div class="project-card__meta">
                        {p.area && <span>{p.area}</span>}
                        {p.city && <span>{p.city}</span>}
                        {p.duration && <span>{p.duration}</span>}
                      </div>
                    )
                  }
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Mid CTA -->
  <section class="section" aria-label="Заявка">
    <div class="container">
      <div class="final-cta__inner reveal">
        <div>
          <h2>Расскажите, что нужно сделать</h2>
          <p>Опишите задачу — поможем понять объем работ и подготовим предварительный расчет.</p>
        </div>
        <div class="final-cta__actions">
          <button class="btn btn--accent" type="button" data-open-form>
            Оставить заявку
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Дополнительные услуги -->
  <AdditionalServices />

  <!-- Как работаем -->
  <Process />

  <!-- Почему РСК Гарант -->
  <WhyUs />

  <!-- Преимущества -->
  <Advantages />

  <!-- Отзывы (скрыт, пока нет реальных отзывов) -->
  <Reviews />

  <!-- Калькулятор стоимости -->
  <CostCalculator />

  <!-- Форма -->
  <FormSection withServiceSelect />

  <!-- FAQ -->
  <Faq items={homeFaq} title="Частые вопросы" />

  <!-- Финальный CTA -->
  <FinalCta />

  <!-- Контакты -->
  <Contacts />
</BaseLayout>
