---
import { mainServices } from '../data/services';

interface Props {
  service?: string;
  withServiceSelect?: boolean;
}

const { service = '', withServiceSelect = false } = Astro.props;
---

<form class="lead-form" id="lead-form" novalidate data-service={service}>
  {!withServiceSelect && <input type="hidden" name="service" value={service} />}

  <div class="field">
    <label for="lf-name">Имя</label>
    <input
      id="lf-name"
      type="text"
      name="name"
      placeholder="Как к вам обращаться"
      autocomplete="name"
      data-error="Введите имя"
      required
    />
    <p class="error" role="alert"></p>
  </div>

  <div class="field">
    <label for="lf-phone">Телефон</label>
    <input
      id="lf-phone"
      type="tel"
      name="phone"
      placeholder="+7 (___) ___-__-__"
      autocomplete="tel"
      inputmode="tel"
      data-error="Введите корректный номер телефона"
      required
    />
    <p class="error" role="alert"></p>
  </div>

  {
    withServiceSelect ? (
      <div class="field">
        <label for="lf-service">Услуга</label>
        <select id="lf-service" name="service">
          <option value="">Выберите услугу</option>
          {
            mainServices.map((s) => (
              <option value={s.title} selected={s.title === service}>{s.title}</option>
            ))
          }
        </select>
        <p class="error" role="alert"></p>
      </div>
    ) : null
  }

  <div class="field">
    <label for="lf-comment">Что нужно сделать</label>
    <textarea
      id="lf-comment"
      name="comment"
      placeholder="Кратко опишите задачу"
      autocomplete="off"
      rows="3"
      maxlength="1000"
    ></textarea>
    <p class="error" role="alert"></p>
  </div>

  <input
    type="text"
    name="website"
    class="honeypot"
    style="position:absolute; left:-9999px; width:1px; height:1px; opacity:0;"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />

  <label class="consent">
    <input type="checkbox" name="consent" value="1" />
    <span>
      Я даю согласие на обработку моих персональных данных (имя, контактные данные, текст сообщения)
      в целях обработки обращения и связи со мной и подтверждаю, что ознакомлен(а) с{' '}
      <a href="/privacy/">политикой конфиденциальности</a>.
    </span>
  </label>
  <p class="consent-error" role="alert">Подтвердите согласие на обработку персональных данных</p>

  <button class="btn btn--primary" type="submit" data-label="Получить расчет">
    Получить расчет
  </button>

  <p class="lead-form__note">
    Специалист свяжется с вами и предварительно рассчитает стоимость ремонта.
  </p>

  <p class="form-status" aria-live="polite"></p>
</form>