---
import { company } from '../data/company';

const address = company.address !== '[ADDRESS]' ? company.address : '';
---

<section class="section section--soft" id="contacts" aria-labelledby="contacts-title">
  <div class="container">
    <div class="contacts-layout">
      <div class="contacts-intro">
        <div class="sec-head__label">Контакты</div>
        <h2 id="contacts-title">Свяжитесь с нами</h2>
        <p>Позвоните или напишите — подскажем по стоимости и срокам, договоримся об осмотре объекта и замере.</p>
        <a class="btn btn--primary" href={company.phoneHref}>
          Позвонить
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <ul class="contacts-list reveal-stagger">
        <li>
          <span class="contacts-list__label">Телефон</span>
          <span class="contacts-list__value">
            <a href={company.phoneHref}>{company.phone}</a>
          </span>
        </li>
        <li>
          <span class="contacts-list__label">Дополнительный телефон</span>
          <span class="contacts-list__value">
            <a href={company.phoneAltHref}>{company.phoneAlt}</a>
          </span>
        </li>
        <li>
          <span class="contacts-list__label">Мессенджеры</span>
          <span class="contacts-list__value contacts-list__value--inline">
            <a href={company.whatsapp} target="_blank" rel="noopener" data-track-messenger="whatsapp">
              WhatsApp
            </a>
            <a href={company.telegram} target="_blank" rel="noopener" data-track-messenger="telegram">
              Telegram
            </a>
          </span>
        </li>
        <li>
          <span class="contacts-list__label">Почта</span>
          <span class="contacts-list__value">
            <a href={`mailto:${company.email}`}>{company.email}</a>
          </span>
        </li>
        <li>
          <span class="contacts-list__label">Регион работ</span>
          <span class="contacts-list__value">
            {company.cityNominative} и {company.region}
          </span>
        </li>
        {company.workingHours && (
          <li>
            <span class="contacts-list__label">График работы</span>
            <span class="contacts-list__value">{company.workingHours}</span>
          </li>
        )}
        {address && (
          <li>
            <span class="contacts-list__label">Адрес</span>
            <span class="contacts-list__value">{address}</span>
          </li>
        )}
      </ul>
    </div>
  </div>
</section>