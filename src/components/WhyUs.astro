---

const reasons = [
  {
    title: 'Бесплатный выезд замерщика',
    text: 'Специалист приедет в удобное время, сделает замеры помещения и проконсультирует по интересующим вопросам.',
  },
  {
    title: 'Работа по договору',
    text: 'Стоимость работ и материалов фиксируем в договоре до начала работ. Ведем отчетность по затратам.',
  },
  {
    title: 'Опыт компании более 15 лет',
    text: 'Берем в работу квартиры разного состояния и подбираем последовательность работ под задачу объекта.',
  },
  {
    title: 'Помощь с материалами',
    text: 'Помогаем подобрать строительные и отделочные материалы и организовать их доставку на объект.',
  },
  {
    title: 'Гарантия на ремонтные работы',
    text: 'Гарантия на выполненные ремонтные работы — 1–3 года по договору.',
  },
  {
    title: 'Гарантия на полотна потолков',
    text: 'На полотна натяжных потолков собственного производства действует гарантия — 12 лет.',
  },
  {
    title: 'Все виды работ в одном месте',
    text: 'Сантехника, электрика, натяжные потолки, отделка — мастера разных профилей под общим управлением.',
  },
];
---

<section class="section" id="about" aria-labelledby="why-title">
  <div class="container">
    <div class="sec-head">
      <div>
        <div class="sec-head__label">О компании</div>
        <h2 id="why-title">Почему РСК Гарант</h2>
        <p>В работе придерживаемся понятных правил — так строим отношения с заказчиками.</p>
      </div>
    </div>

    <div class="why-grid reveal-stagger">
      {
        reasons.map((r, i) => (
          <article class="why-item">
            <div class="why-item__num">{String(i + 1).padStart(2, '0')}</div>
            <h3>{r.title}</h3>
            <p>{r.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
