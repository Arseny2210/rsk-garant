---
import { company } from '../data/company';
import { mainServices, additionalServices } from '../data/services';

const year = new Date().getFullYear();
const address = company.address !== '[ADDRESS]' ? company.address : '';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a class="logo" href="/" aria-label="РСК Гарант — на главную">
          <img
            class="logo__img"
            src="/logo.webp"
            alt="РСК Гарант"
            width="240"
            height="160"
            loading="lazy"
          />
        </a>
        <p>Ремонт квартир и отдельные строительные работы в Москве и Московской области.</p>
      </div>

      <nav aria-label="Основные услуги">
        <h3>Услуги</h3>
        <ul>
          {
            mainServices.map((s) => (
              <li><a href={s.slug}>{s.title}</a></li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Дополнительные работы">
        <h3>Также выполняем</h3>
        <ul>
          {
            additionalServices.slice(0, 8).map((s) => (
              <li><a href={'/#additional'}>{s.title}</a></li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h3>Контакты</h3>
        <ul>
          <li><a href={company.phoneHref}>{company.phone}</a></li>
          <li><a href={company.phoneAltHref}>{company.phoneAlt}</a></li>
          <li><a href={`mailto:${company.email}`}>{company.email}</a></li>
          <li><a href={company.whatsapp} target="_blank" rel="noopener">WhatsApp</a></li>
          <li><a href={company.telegram} target="_blank" rel="noopener">Telegram</a></li>
          {address && <li>{address}</li>}
          <li>{company.cityNominative} и {company.region}</li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <span>© {year} {company.name}</span>
      <nav aria-label="Служебные ссылки">
        <ul style="display:flex; gap:1.5rem; flex-wrap:wrap;">
          <li><a href="/privacy/">Политика конфиденциальности</a></li>
          <li><a href="/#contacts">Контакты</a></li>
          <li>
            <a
              href="https://commons.wikimedia.org/wiki/File:Modern_living_room_with_stylish_furniture_and_a_view_of_the_outdoors_in_a_cozy_apartment_setting.jpg"
              target="_blank"
              rel="noopener"
            >
              Фото интерьера на главной: Shixart1985 / Wikimedia Commons (CC BY 2.0)
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</footer>