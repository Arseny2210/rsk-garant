# ============================================================
# MAX integration
# Секреты НИКОГДА не попадают во frontend — используются
# только server-side в /api/lead.
# Скопируйте этот файл в .env и заполните реальными значениями.
# ============================================================

# Базовый URL платформы MAX (по умолчанию https://platform-api2.max.ru/)
MAX_API_BASE=https://platform-api2.max.ru/

# Токен бота MAX (access token)
MAX_BOT_TOKEN=

# Идентификатор чата, куда падают заявки
MAX_CHAT_ID=

# Разрешенные источники запросов (через запятую).
# По умолчанию — http://localhost:4321,http://localhost:3000 и
# production-домен из настроек сайта.
ALLOWED_ORIGINS=https://rsk-garant.ru

# Порт для standalone-сервера (npm start)
HOST=0.0.0.0
PORT=4321

# Аналитика. Заполнить, когда появятся реальные ID.
# YANDEX_METRIKA_ID=
# GOOGLE_ANALYTICS_ID=